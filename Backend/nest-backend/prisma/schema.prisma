generator client {
  provider      = "prisma-client-js"
  // node:20-alpine (Docker) — musl libc + OpenSSL 3.x, lokal dev esa Debian/glibc.
  // "native" ikkalasini ham qamrab olmaydi, shuning uchun aniq qo'shildi.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  phone              String    @unique
  email              String    @unique
  passwordHash       String    @map("password_hash")
  role               String    @default("") @db.VarChar(20)
  fullName           String    @map("full_name")
  avatarUrl          String    @default("") @map("avatar_url")
  language           String    @default("uz")
  isVerified         Boolean   @default(false) @map("is_verified")
  emailVerified      Boolean   @default(false) @map("email_verified")
  emailOtpCode       String    @default("") @map("email_otp_code")
  emailOtpExpiresAt  DateTime? @map("email_otp_expires_at")
  emailOtpLastSentAt DateTime? @map("email_otp_last_sent_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  shop          ShopProfile?
  vehicles      Vehicle[]      @relation("VehicleOwner")
  bookings      Booking[]      @relation("BookingCustomer")
  reviews       Review[]       @relation("ReviewAuthor")
  notifications Notification[] @relation("UserNotifications")
  fcmTokens     FCMToken[]     @relation("UserFCMTokens")
  customerCards CustomerCard[] @relation("CustomerCardUser")
  master        Master?        @relation("MasterUser")
  evacuator     Evacuator?     @relation("EvacuatorUser")
  sosRequests   SosRequest[]   @relation("SosRequestCustomer")
  sosMessages   SosMessage[]   @relation("SosMessageSender")

  @@map("users")
}

model ShopProfile {
  id                 String                                 @id @default(uuid()) @db.Uuid
  userId             String                                 @unique @map("user_id") @db.Uuid
  shopName           String                                 @default("") @map("shop_name")
  address            String                                 @default("")
  latitude           Float                                  @default(0)
  longitude          Float                                  @default(0)
  /// Geo-qidiruv uchun (Faza 3). Prisma bu turni to'g'ridan-to'g'ri
  /// qo'llamaydi — o'qish/yozish $queryRaw bilan, GiST index migratsiyada
  /// qo'lda yaratilgan (CLAUDE.md §8.1).
  location           Unsupported("geography(Point, 4326)")?
  phone              String                                 @default("")
  workingHours       String                                 @default("") @map("working_hours")
  serviceTypes       String[]                               @map("service_types")
  verificationStatus String                                 @default("pending") @map("verification_status") @db.VarChar(20)
  verificationNotes  String                                 @default("") @map("verification_notes")
  ratingAvg          Float                                  @default(0) @map("rating_avg")
  ratingCount        Int                                    @default(0) @map("rating_count")
  totalBookings      Int                                    @default(0) @map("total_bookings")
  createdAt          DateTime                               @default(now()) @map("created_at")
  updatedAt          DateTime                               @updatedAt @map("updated_at")

  user          User               @relation(fields: [userId], references: [id])
  bookings      Booking[]          @relation("BookingShop")
  customerCards CustomerCard[]     @relation("CustomerCardShop")
  servicePrices ShopServicePrice[] @relation("ShopPrices")
  masters       Master[]           @relation("ShopMasters")
  sosDispatches SosDispatch[]      @relation("SosDispatchShop")

  @@map("shop_profiles")
}

model Master {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @map("shop_id") @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  fullName    String   @map("full_name")
  position    String   @default("")
  avatarUrl   String   @default("") @map("avatar_url")
  isActive    Boolean  @default(true) @map("is_active")
  ratingAvg   Float    @default(0) @map("rating_avg")
  ratingCount Int      @default(0) @map("rating_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  shop                ShopProfile         @relation("ShopMasters", fields: [shopId], references: [id])
  user                User                @relation("MasterUser", fields: [userId], references: [id])
  bookings            Booking[]           @relation("BookingMaster")
  serviceTypes        MasterServiceType[] @relation("MasterServices")
  acceptedSosRequests SosRequest[]        @relation("SosRequestAcceptedMaster")

  @@index([shopId])
  @@map("masters")
}

model MasterServiceType {
  masterId      String @map("master_id") @db.Uuid
  serviceTypeId String @map("service_type_id") @db.Uuid

  master      Master      @relation("MasterServices", fields: [masterId], references: [id], onDelete: Cascade)
  serviceType ServiceType @relation("ServiceTypeMasters", fields: [serviceTypeId], references: [id], onDelete: Cascade)

  @@id([masterId, serviceTypeId])
  @@index([serviceTypeId])
  @@map("master_service_types")
}

model Vehicle {
  id            String   @id @default(uuid()) @db.Uuid
  plate         String   @unique
  ownerId       String   @map("owner_id") @db.Uuid
  make          String   @default("")
  model         String   @default("")
  year          Int      @default(0)
  color         String   @default("")
  photoUrl      String   @default("") @map("photo_url")
  /// Joriy probeg, km. 0 — mijoz hali kiritmagan.
  mileageKm     Int      @default(0) @map("mileage_km")
  /// Keyingi TO qaysi probegda kerak, km. 0 — belgilanmagan.
  /// "Через X km" = nextServiceKm - mileageKm (ilova tomonida hisoblanadi).
  nextServiceKm Int      @default(0) @map("next_service_km")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  owner       User         @relation("VehicleOwner", fields: [ownerId], references: [id])
  bookings    Booking[]    @relation("BookingVehicle")
  sosRequests SosRequest[] @relation("SosRequestVehicle")

  @@map("vehicles")
}

model ServiceType {
  id       String  @id @default(uuid()) @db.Uuid
  slug     String  @unique
  nameUz   String  @map("name_uz")
  nameRu   String  @map("name_ru")
  icon     String  @default("")
  /// Bosh ekrandagi guruhlash uchun kategoriya slug'i. Lug'at kod darajasida
  /// (icon kutubxonasi bilan bir xil andoza): tires | engine | brakes |
  /// transmission | electrics | body | other. Bo'sh = other.
  category String  @default("") @db.VarChar(30)
  /// Katalog darajasidagi taxminiy narx diapazoni ("...dan — ...gacha"),
  /// mijozga xizmatni tanlashdan oldin umumiy tasavvur berish uchun.
  /// Har bir servisning haqiqiy narxi alohida — CLAUDE.md §6.
  priceMin Int     @default(0) @map("price_min")
  priceMax Int     @default(0) @map("price_max")
  isActive Boolean @default(true) @map("is_active")

  bookings    Booking[]           @relation("BookingServiceType")
  shopPrices  ShopServicePrice[]  @relation("ServiceTypePrices")
  masters     MasterServiceType[] @relation("ServiceTypeMasters")
  sosRequests SosRequest[]        @relation("SosRequestServiceType")

  @@map("service_types")
}

model Promo {
  id        String    @id @default(uuid()) @db.Uuid
  badgeUz   String    @default("") @map("badge_uz")
  badgeRu   String    @default("") @map("badge_ru")
  titleUz   String    @map("title_uz")
  titleRu   String    @map("title_ru")
  isActive  Boolean   @default(true) @map("is_active")
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  views     Int       @default(0)
  clicks    Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("promos")
}

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_config")
}

model ShopServicePrice {
  id            String   @id @default(uuid()) @db.Uuid
  shopId        String   @map("shop_id") @db.Uuid
  serviceTypeId String   @map("service_type_id") @db.Uuid
  priceMin      Int      @default(0) @map("price_min")
  priceMax      Int      @default(0) @map("price_max")
  currency      String   @default("UZS") @map("currency") @db.VarChar(10)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  shop        ShopProfile @relation("ShopPrices", fields: [shopId], references: [id])
  serviceType ServiceType @relation("ServiceTypePrices", fields: [serviceTypeId], references: [id])

  @@unique([shopId, serviceTypeId])
  @@map("shop_service_prices")
}

model Booking {
  id                   String    @id @default(uuid()) @db.Uuid
  customerId           String    @map("customer_id") @db.Uuid
  shopId               String    @map("shop_id") @db.Uuid
  masterId             String    @map("master_id") @db.Uuid
  vehicleId            String    @map("vehicle_id") @db.Uuid
  serviceTypeId        String    @map("service_type_id") @db.Uuid
  scheduledAt          DateTime  @map("scheduled_at")
  notes                String    @default("")
  status               String    @default("pending") @db.VarChar(30)
  totalPrice           Int       @default(0) @map("total_price")
  cancelReason         String    @default("") @map("cancel_reason")
  completedAt          DateTime? @map("completed_at")
  reviewReminderSentAt DateTime? @map("review_reminder_sent_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  customer    User        @relation("BookingCustomer", fields: [customerId], references: [id])
  shop        ShopProfile @relation("BookingShop", fields: [shopId], references: [id])
  master      Master      @relation("BookingMaster", fields: [masterId], references: [id])
  vehicle     Vehicle     @relation("BookingVehicle", fields: [vehicleId], references: [id])
  serviceType ServiceType @relation("BookingServiceType", fields: [serviceTypeId], references: [id])
  payment     Payment?    @relation("BookingPayment")
  tips        Tip[]       @relation("BookingTips")
  reviews     Review[]    @relation("BookingReviews")

  @@index([masterId])
  @@map("bookings")
}

/// `bookingId`/`sosRequestId`dan faqat bittasi to'ladi (DB CHECK cheklovi
/// bilan ta'minlangan, migratsiyaga qarang).
model Payment {
  id           String    @id @default(uuid()) @db.Uuid
  bookingId    String?   @unique @map("booking_id") @db.Uuid
  sosRequestId String?   @unique @map("sos_request_id") @db.Uuid
  amount       Int       @default(0)
  method       String    @default("") @db.VarChar(30)
  status       String    @default("pending") @db.VarChar(20)
  qrCode       String    @default("") @map("qr_code")
  paidAt       DateTime? @map("paid_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  booking    Booking?    @relation("BookingPayment", fields: [bookingId], references: [id])
  sosRequest SosRequest? @relation("SosRequestPayment", fields: [sosRequestId], references: [id])

  @@map("payments")
}

/// `bookingId`/`sosRequestId`dan faqat bittasi to'ladi (DB CHECK cheklovi
/// bilan ta'minlangan, migratsiyaga qarang).
model Tip {
  id           String   @id @default(uuid()) @db.Uuid
  bookingId    String?  @map("booking_id") @db.Uuid
  sosRequestId String?  @map("sos_request_id") @db.Uuid
  amount       Int
  createdAt    DateTime @default(now()) @map("created_at")

  booking    Booking?    @relation("BookingTips", fields: [bookingId], references: [id])
  sosRequest SosRequest? @relation("SosRequestTips", fields: [sosRequestId], references: [id])

  @@map("tips")
}

model CustomerCard {
  id          String    @id @default(uuid()) @db.Uuid
  shopId      String    @map("shop_id") @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid
  isVip       Boolean   @default(false) @map("is_vip")
  notes       String    @default("")
  visitCount  Int       @default(0) @map("visit_count")
  lastVisitAt DateTime? @map("last_visit_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  shop     ShopProfile @relation("CustomerCardShop", fields: [shopId], references: [id])
  customer User        @relation("CustomerCardUser", fields: [customerId], references: [id])

  @@unique([shopId, customerId])
  @@map("customer_cards")
}

model Review {
  id          String   @id @default(uuid()) @db.Uuid
  bookingId   String   @map("booking_id") @db.Uuid
  authorId    String   @map("author_id") @db.Uuid
  targetId    String   @map("target_id") @db.Uuid
  reviewType  String   @map("review_type") @db.VarChar(20)
  rating      Int
  comment     String   @default("")
  isModerated Boolean  @default(false) @map("is_moderated")
  createdAt   DateTime @default(now()) @map("created_at")

  booking Booking @relation("BookingReviews", fields: [bookingId], references: [id])
  author  User    @relation("ReviewAuthor", fields: [authorId], references: [id])

  @@unique([bookingId, reviewType])
  @@map("reviews")
}

model SeasonalRule {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  sendMonth  Int       @map("send_month")
  sendDay    Int       @map("send_day")
  messageUz  String    @map("message_uz")
  messageRu  String    @map("message_ru")
  isActive   Boolean   @default(true) @map("is_active")
  lastSentAt DateTime? @map("last_sent_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("seasonal_rules")
}

model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String
  body        String
  type        String   @default("")
  referenceId String   @default("") @map("reference_id")
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation("UserNotifications", fields: [userId], references: [id])

  @@map("notifications")
}

model FCMToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String
  platform  String   @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation("UserFCMTokens", fields: [userId], references: [id])

  @@map("fcm_tokens")
}

/// Faza 3 — SOS so'rovi. Mijoz joylashuvi geo-qidiruv uchun `location`da
/// saqlanadi (PostGIS geography), o'qish/yozish $queryRaw bilan (CLAUDE.md §8.1).
/// Status: pending → dispatching → accepted | no_master_found → completed | cancelled.
/// `dispatchMode` — 'shop' (ustaxonalarga) yoki 'evacuator' (Faza 3.7,
/// hech kim topilmagandan keyin mijoz evakuator so'rasa) — bitta SosRequest
/// ikkala rejimni ham ketma-ket bosib o'tishi mumkin (avval shop, keyin
/// evacuator), shuning uchun to'lqin hisobi `evacuatorRequestedAt`dan
/// qayta boshlanadi.
model SosRequest {
  id                   String                                @id @default(uuid()) @db.Uuid
  customerId           String                                @map("customer_id") @db.Uuid
  vehicleId            String                                @map("vehicle_id") @db.Uuid
  serviceTypeId        String                                @map("service_type_id") @db.Uuid
  /// $queryRaw orqali to'ldiriladi (create vaqtida ST_SetSRID/ST_MakePoint).
  location             Unsupported("geography(Point, 4326)")
  status               String                                @default("pending") @map("status") @db.VarChar(20)
  dispatchMode         String                                @default("shop") @map("dispatch_mode") @db.VarChar(20)
  acceptedMasterId     String?                               @map("accepted_master_id") @db.Uuid
  acceptedEvacuatorId  String?                               @map("accepted_evacuator_id") @db.Uuid
  evacuatorRequestedAt DateTime?                             @map("evacuator_requested_at")
  expiresAt            DateTime?                             @map("expires_at")
  createdAt            DateTime                              @default(now()) @map("created_at")
  updatedAt            DateTime                              @updatedAt @map("updated_at")

  customer          User          @relation("SosRequestCustomer", fields: [customerId], references: [id])
  vehicle           Vehicle       @relation("SosRequestVehicle", fields: [vehicleId], references: [id])
  serviceType       ServiceType   @relation("SosRequestServiceType", fields: [serviceTypeId], references: [id])
  acceptedMaster    Master?       @relation("SosRequestAcceptedMaster", fields: [acceptedMasterId], references: [id])
  acceptedEvacuator Evacuator?    @relation("SosRequestAcceptedEvacuator", fields: [acceptedEvacuatorId], references: [id])
  dispatches        SosDispatch[] @relation("SosRequestDispatches")
  messages          SosMessage[]  @relation("SosRequestMessages")
  payment           Payment?      @relation("SosRequestPayment")
  tips              Tip[]         @relation("SosRequestTips")

  @@index([status])
  @@index([customerId])
  @@map("sos_requests")
}

/// Faza 3 — bitta SOS so'rovi bo'yicha qaysi servisga (yoki Faza 3.7'da
/// qaysi evakuatorga), qaysi to'lqinda yuborilgani va javobi (jurnal).
/// Har bir yozuv aynan bittasiga tegishli: yo `shopId`, yo `evacuatorId`.
model SosDispatch {
  id             String    @id @default(uuid()) @db.Uuid
  sosRequestId   String    @map("sos_request_id") @db.Uuid
  shopId         String?   @map("shop_id") @db.Uuid
  evacuatorId    String?   @map("evacuator_id") @db.Uuid
  wave           Int
  distanceMeters Int       @default(0) @map("distance_meters")
  status         String    @default("sent") @map("status") @db.VarChar(20)
  sentAt         DateTime  @default(now()) @map("sent_at")
  respondedAt    DateTime? @map("responded_at")

  sosRequest SosRequest   @relation("SosRequestDispatches", fields: [sosRequestId], references: [id], onDelete: Cascade)
  shop       ShopProfile? @relation("SosDispatchShop", fields: [shopId], references: [id])
  evacuator  Evacuator?   @relation("SosDispatchEvacuator", fields: [evacuatorId], references: [id])

  @@index([sosRequestId])
  @@index([shopId, status])
  @@index([evacuatorId, status])
  @@map("sos_dispatches")
}

/// Faza 3.7 — evakuator (evakuator haydovchisi). Servisga bog'lanmagan
/// mustaqil operator, o'z login bilan kiradi. `location` mobil bo'lgani
/// uchun ilova ochilganda/online bo'lganda yangilanadi (shop kabi doimiy
/// manzil emas).
model Evacuator {
  id           String                                 @id @default(uuid()) @db.Uuid
  userId       String                                 @unique @map("user_id") @db.Uuid
  fullName     String                                 @map("full_name")
  phone        String                                 @default("")
  vehiclePlate String                                 @default("") @map("vehicle_plate")
  isActive     Boolean                                @default(true) @map("is_active")
  isAvailable  Boolean                                @default(true) @map("is_available")
  /// $queryRaw orqali o'qiladi/yoziladi (CLAUDE.md §8.1).
  location     Unsupported("geography(Point, 4326)")?
  ratingAvg    Float                                  @default(0) @map("rating_avg")
  ratingCount  Int                                    @default(0) @map("rating_count")
  createdAt    DateTime                               @default(now()) @map("created_at")
  updatedAt    DateTime                               @updatedAt @map("updated_at")

  user             User          @relation("EvacuatorUser", fields: [userId], references: [id])
  dispatches       SosDispatch[] @relation("SosDispatchEvacuator")
  acceptedRequests SosRequest[]  @relation("SosRequestAcceptedEvacuator")

  @@map("evacuators")
}

/// Faza 3.5 — SOS so'rovi qabul qilingandan keyin mijoz ↔ usta chati.
/// Mavjud WebSocket Gateway ustiga quriladi (yangi kanal yo'q), shu yerda
/// faqat tarix uchun saqlanadi.
model SosMessage {
  id           String   @id @default(uuid()) @db.Uuid
  sosRequestId String   @map("sos_request_id") @db.Uuid
  senderUserId String   @map("sender_user_id") @db.Uuid
  body         String
  createdAt    DateTime @default(now()) @map("created_at")

  sosRequest SosRequest @relation("SosRequestMessages", fields: [sosRequestId], references: [id], onDelete: Cascade)
  sender     User       @relation("SosMessageSender", fields: [senderUserId], references: [id])

  @@index([sosRequestId])
  @@map("sos_messages")
}
